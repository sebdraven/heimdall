# Copy to .env (never commit it). Passwords are embedded in a DSN URL:
# use URL-safe characters only, e.g. `openssl rand -hex 24`.
POSTGRES_PASSWORD=
CLICKHOUSE_USER=heimdall
CLICKHOUSE_PASSWORD=

# Optional tuning (defaults shown).
# HEIMDALL_WORKERS=32
# HEIMDALL_DNS_TIMEOUT=3s
# HEIMDALL_RELOAD_INTERVAL=60s
# HEIMDALL_BATCH_SIZE=5000
# HEIMDALL_BATCH_FLUSH=5s
# Consecutive absences before a value of A/AAAA/NS/MX/TXT counts as removed.
# HEIMDALL_REMOVAL_GRACE=3
# Period at which changed change-detection states are persisted.
# HEIMDALL_STATE_SNAPSHOT=1m
# New domains get their first resolution within this delay (or their interval if shorter).
# HEIMDALL_FIRST_RUN_SPREAD=5m
# HEIMDALL_SESSION_TTL=12h
# HEIMDALL_MIGRATE=true
# HEIMDALL_LOG_LEVEL=info

# VirusTotal passive DNS in the graph view. Empty key: disabled, no request.
# HEIMDALL_VT_API_KEY=
# Lookups per UTC day for Heimdall, under the key's own daily quota.
# HEIMDALL_VT_DAILY_BUDGET=500
# An object looked up less than this ago is not looked up again.
# HEIMDALL_VT_TTL=168h

# Certificate Transparency search of the domain enrichment (Cert Spotter API).
# HEIMDALL_CT_URL=https://api.certspotter.com
# Cert Spotter API key, sent as a bearer token. Empty: the public API, which
# limits the number of requests.
# HEIMDALL_CERTSPOTTER_API_KEY=
# ONYPHE (category ctl), a second CT source merged with Cert Spotter by
# SHA-256. Empty key: disabled, no request.
# HEIMDALL_ONYPHE_API_KEY=
# HEIMDALL_ONYPHE_URL=https://www.onyphe.io/api/v2
# OQL time function of the search; without one ONYPHE searches 30 days.
# HEIMDALL_ONYPHE_CT_WINDOW=-since:48M

# Self-hosted, open Lookyloo instance of the domain enrichment. Empty:
# disabled, no request. Give the full MagicDNS name: the DNS of the
# containers does not resolve the short ones.
# HEIMDALL_LOOKYLOO_URL=http://citizen-lab.tail399dd.ts.net:5100
# Captures read per name, latest first.
# HEIMDALL_LOOKYLOO_MAX_CAPTURES=10
# Submit https://<name>/ (unlisted) when no capture is younger than MAX_AGE.
# HEIMDALL_LOOKYLOO_SUBMIT=false
# HEIMDALL_LOOKYLOO_MAX_AGE=720h

# Only for plain-HTTP development: drops the Secure flag on cookies.
# HEIMDALL_INSECURE_COOKIE=false
